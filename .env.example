# ==========================================
# CSBOT - Configuration des Variables d'Environnement
# ==========================================

# --- TELEGRAM BOT ---
BOT_TOKEN="votre_token_telegram_bot_ici"
COPRO_CHAT_ID=CHAT_ID_COPRO
CS_GROUP_ID=CHAT_ID_CS_GROUP
ADMIN_IDS=[ADMIN_ID_A, ADMIN_ID_B]

# --- BASE DE DONNÉES (MariaDB / MySQL) ---
DB_USER="csbot_user"
DB_PASSWORD="csbot_password"
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="csbot"

# --- INTÉGRATION CPTCOPRO (Optionnel) ---
CPTCOPRO_DB_USER="cptcopro_user"
CPTCOPRO_DB_PASSWORD="cptcopro_password"
CPTCOPRO_DB_HOST="localhost"
CPTCOPRO_DB_PORT=3306
CPTCOPRO_DB_NAME="cptcopro"

# --- MOTEURS D'IA (LLM) ---
GEMINI_API_KEY="votre_cle_gemini_api_ici"
MISTRAL_API_KEY="votre_cle_mistral_api_ici"
DEFAULT_LLM_PROVIDER="gemini"
GEMINI_MODEL="gemini-2.5-flash"
MISTRAL_MODEL="mistral-medium-latest"

# --- INTÉGRATION N8N (Optionnel) ---
N8N_WEBHOOK_URL="https://n8n.votre-domaine.fr/webhook/csbot-events"
N8N_WEBHOOK_SECRET="un_secret_aleatoire_tres_robuste"
WEBHOOK_SERVER_HOST="0.0.0.0"
WEBHOOK_SERVER_PORT=8088

# --- URGENCES & ASTREINTES 24/7 ---
EMERGENCY_ASCENSEUR_PHONE="01 40 00 00 00"
EMERGENCY_CHAUFFAGE_PHONE="01 41 00 00 00"
EMERGENCY_PLOMBERIE_PHONE="01 42 00 00 00"
WATER_VALVE_LOCATION="Sous-sol Bâtiment B, porte coupe-feu à gauche"
GAS_VALVE_LOCATION="Coffret extérieur jaune sur rue"
ELECTRIC_ROOM_LOCATION="RDC, couloir principal côté local vélos"

# --- ENCOMBRANTS ---
ENCOMBRANTS_SCHEDULE="1er mardi du mois à partir de 19h"

